# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit .env yang berisi nilai asli.

# PostgreSQL (lokal atau Neon). Untuk Neon, sertakan ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/studyflow?sslmode=require"

# Wajib di produksi. Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-byte"

# URL publik aplikasi. Wajib di produksi agar cookie Secure & redirect benar.
AUTH_URL="https://domain-kamu.com"

# Web Push (VAPID). Buat key dengan: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:admin@domain-kamu.com"

# Secret untuk endpoint cron pengingat tenggat (Authorization: Bearer <CRON_SECRET>).
# Buat dengan: openssl rand -hex 32
CRON_SECRET="..."
